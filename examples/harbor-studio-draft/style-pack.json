{
  "schema_version": "1.0",
  "project": {
    "id": "harbor-studio",
    "name": "港湾工作室 · 团队游戏资产体系",
    "domain": "game-art",
    "owner": "原创演示，负责角色由真实项目接入时指定"
  },
  "version": "0.5.0",
  "status": "draft",
  "scope": {
    "medium": "2d",
    "view": "正视棋盘与轻微偏侧的日光街区；具体透视为待确认提案",
    "target_platform": "移动游戏场景及活动宣传；目标设备、语言和渠道尺寸待验证",
    "asset_types": [
      "character",
      "environment",
      "tile",
      "prop",
      "ui",
      "motion",
      "layout",
      "typography"
    ]
  },
  "intent": {
    "summary": "把轻量漫画方向组织成八个制作家族，以样板和首件校准，再交给角色、场景、棋子、UI、道具、动效、排版和宣传成员并行生产。方向来自已有原创候选板，专业判断为供评审的提案。",
    "pillars": [
      "玩家先看懂操作与反馈",
      "同一角色和物件跨状态保留身份",
      "用首件与组合验证后再扩批",
      "探索结果可以提升后续基线"
    ],
    "avoid": [
      "通过复杂纹理、体积光或密集碎片掩盖轮廓",
      "各制作线自行切换到写实、厚涂或立体塑料质感",
      "只靠颜色区分棋子",
      "把样板板中的角色小图直接当成已确认身份图",
      "把模型字形当作真实UI文字",
      "把计划数量、模拟收件或脚本通过写成真实量产完成"
    ]
  },
  "tokens": {
    "colors": {
      "coral": "#F47C6A",
      "mint": "#80CDA8",
      "yellow": "#FFD66B",
      "blue": "#7BAFE8",
      "ink": "#25303E",
      "paper": "#FFF4DB",
      "flower_pink_proposed": "#ED9CB5"
    },
    "fonts": {
      "body": {
        "family": "待确认支持中文与拉丁字母的圆润无衬线实际字体",
        "fallback": "由项目确认字形覆盖、授权与备用字体"
      },
      "numbers": {
        "family": "待确认清楚区分0/O与1/I的数字字体",
        "fallback": "随实际UI排版测试确认"
      }
    }
  },
  "rules": [
    {
      "id": "STYLE-01",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "候选风格采用轻量美式报刊与周日漫画气氛：宽松清晰轮廓、扁平色块、友善日光和可辨识的简化形体。",
      "rationale": "让多条生产线共享可观察的风格判断。",
      "allowed_variation": [
        "主体可有少量幽默夸张，但不改变用途和整体可读性"
      ],
      "evidence": [
        "PB-STYLE-BOARD",
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "PALETTE-01",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "以暖奶油paper为底、深蓝灰ink为描边，主体使用coral、mint、yellow、blue；粉花可使用flower_pink_proposed候选色。新增颜色应说明用途与取舍。",
      "rationale": "限制色彩分歧，同时允许五种棋子双重识别。",
      "allowed_variation": [
        "同色的阴影明度可变化，需记录实际色值",
        "背景可降低饱和度以衬托棋盘"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "LINE-01",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "深蓝灰轮廓保持连续、宽松和清楚，内部细节少于外形信息；线宽随显示尺度统一调整，不能逐张随意改变。",
      "rationale": "同批资产在缩小后仍像同一套作品。",
      "allowed_variation": [
        "背景内部线可比交互主体更轻",
        "外轮廓可有轻微手绘起伏"
      ],
      "evidence": [
        "PB-STYLE-BOARD",
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "SHADE-01",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "采用基色加一级块状阴影的两级明暗，不依靠连续渐变或真实反射塑造体积。",
      "rationale": "降低风格漂移与小尺寸视觉噪声。",
      "allowed_variation": [
        "极小高光可作为功能或材质提示，但不能增加复杂明暗层次"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "READ-01",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "在任务实际显示尺度、背景和相邻资产中检查轮廓与层级；仅看放大单图不能记录为可读性通过。",
      "rationale": "资产最终服务连续游戏画面。",
      "allowed_variation": [
        "不同类别可使用各自的合成场景，需保留观察证据"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "human",
      "status": "proposed"
    },
    {
      "id": "REF-01",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "综合板表达候选视觉语言，左上人物另登记为候选身份区域；它不替代精细转面、真实 UI、首件或组合的批准样板。",
      "rationale": "风格相似不能证明同一对象的身份已锁定。",
      "allowed_variation": [
        "身份参考缺失时可制作文字约束下的候选，但必须保留未验证标记"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "human",
      "status": "proposed"
    },
    {
      "id": "CHAR-01",
      "scope": [
        "character"
      ],
      "strength": "must",
      "statement": "Mira 的候选身份是深蓝短侧分波波头、暖肤与原参考的脸部比例；衣装不是永久身份，指定换装时开放衣装槽位。",
      "rationale": "区分同一角色的姿态制作与重新设计。",
      "allowed_variation": [
        "任务开放的衣装、表情与动作",
        "遮挡五官时补可比较的视图"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "CHAR-02",
      "scope": [
        "character"
      ],
      "strength": "should",
      "statement": "姿态用清楚的大动作表达，面部细节节制；角色与棋盘同屏时不能占据关键操作区域。",
      "rationale": "角色支持街区故事和反馈，同时保留游戏焦点。",
      "allowed_variation": [
        "独立胜利画面可扩大动作幅度，需在对应任务写明"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "ENV-01",
      "scope": [
        "environment"
      ],
      "strength": "must",
      "statement": "背景采用日光、圆角街区与店铺；以清楚入口和少量生活道具表达店铺用途，棋盘后方留低细节区域。",
      "rationale": "各场景可更换叙事内容，同时持续支持棋盘识别。",
      "allowed_variation": [
        "店招形状、货物与街角摆设可变化",
        "真实店名文字另行排版"
      ],
      "evidence": [
        "PB-STYLE-BOARD",
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "ENV-02",
      "scope": [
        "environment"
      ],
      "strength": "should",
      "statement": "同批场景保持一致日光方向和视线高度，背景反差低于棋子；变化先在合成图中评估。",
      "rationale": "降低关卡切换时的视觉跳变。",
      "allowed_variation": [
        "特殊时间或天气作为另立任务的候选，不自动扩展本批规则"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TILE-01",
      "scope": [
        "tile"
      ],
      "strength": "must",
      "statement": "五种棋子使用红苹果、绿叶、黄星、蓝水滴、粉花的双重识别；保持圆润的各自轮廓，不将其统一为只换色的圆球，也不添加五官。",
      "rationale": "形状和颜色共同承载种类识别，减少只靠颜色的歧义。",
      "allowed_variation": [
        "小幅手绘轮廓起伏和一级阴影可变化",
        "选中或消除状态不能替换种类轮廓"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TILE-02",
      "scope": [
        "tile"
      ],
      "strength": "must",
      "statement": "选中态保留基础棋子的完整轮廓，以统一外圈和轻微位移表达状态；候选64px显示下外圈宽度为2px，此数值尚未在目标设备验证。",
      "rationale": "状态识别与棋子种类识别应同时成立。",
      "allowed_variation": [
        "可在实际尺寸试验后提交外圈宽度变更，变更需形成新版本"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "human",
      "status": "proposed"
    },
    {
      "id": "PROP-01",
      "scope": [
        "prop"
      ],
      "strength": "must",
      "statement": "纸风车以折叠纸叶片和短柄、木槌以圆角木锤头和握柄、邮包以盒体和折盖表达用途；静止、激活和包装变体保留关键结构。",
      "rationale": "内制母版与外包变体共享同一物件身份。",
      "allowed_variation": [
        "授权任务可改配色、表面图案或开启状态",
        "结构变化须作为重新设计提案"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "PROP-02",
      "scope": [
        "prop"
      ],
      "strength": "must",
      "statement": "外包变体逐项绑定指定母版、规范版本和指纹；依赖母版缺失时只制作候选探索，不能将样板板截取图当成已确认母版。",
      "rationale": "外包作为交付角色使用相同规则，避免追溯链中断。",
      "allowed_variation": [
        "包装与配色可在任务明确范围内变化"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "technical",
      "status": "proposed"
    },
    {
      "id": "UI-01",
      "scope": [
        "ui"
      ],
      "strength": "must",
      "statement": "按钮和面板使用简洁圆角、深色细描边和清楚层级，图标与文字分别制作；棋盘操作区不被装饰侵占。",
      "rationale": "界面继承漫画气氛并保持操作清楚。",
      "allowed_variation": [
        "主次按钮可用填色和面积区分",
        "圆角与边距数值在目标屏幕试排后确认"
      ],
      "evidence": [
        "PB-STYLE-BOARD",
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TYPE-01",
      "scope": [
        "ui"
      ],
      "strength": "must",
      "statement": "UI中文、拉丁字母、数字与标点使用真实字体单独排版，检查来源、语言覆盖、真实字数和实际尺寸；模型生成的字形不作为交付文字。",
      "rationale": "可读文字与可维护组件需要真实排版信息。",
      "allowed_variation": [
        "字体选择、字号与字重可作为有依据的候选提交"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "human",
      "status": "proposed"
    },
    {
      "id": "MOTION-01",
      "scope": [
        "motion"
      ],
      "strength": "must",
      "statement": "每套动效明确anticipation预备、burst爆点、settle收束三个阶段，以弹性小爆点和短暂反馈服务操作结果。",
      "rationale": "统一动作语法便于批量制作和比较。",
      "allowed_variation": [
        "三阶段的时长可按操作语义调整，并逐套记录",
        "无效交换以回弹收束，不冒充成功消除"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "MOTION-02",
      "scope": [
        "motion"
      ],
      "strength": "must",
      "statement": "动效避免遮挡棋盘；单棋消除的候选峰值包围盒不超过棋格1.25倍，并以叠加回放检查邻格与结果可见性；该数值不代表实测性能或通过验收。",
      "rationale": "持续消除时玩家仍需读懂相邻棋子和下一步。",
      "allowed_variation": [
        "直线消除可沿目标行列延伸，但不能以满屏粒子替代清楚的结果反馈",
        "修改覆盖范围需新版本和受影响动效复查"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "human",
      "status": "proposed"
    },
    {
      "id": "MOTION-03",
      "scope": [
        "tile",
        "motion"
      ],
      "strength": "must",
      "statement": "动作只改变位置、缩放、旋转与允许的短暂变形；不得给无五官的静态棋子新增眼睛或嘴，也不得重设计种类轮廓。",
      "rationale": "动作变化不应造成身份变化；样板生成中出现过星棋子动效新增五官的真实候选问题。",
      "allowed_variation": [
        "局部碎片和弹性变形应在收束时回到规定结果，需逐帧观察"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "DELIVERY-01",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "每个交付项携带asset_id、task_id、项目id、规范版本与实际指纹，并记录实际工具、参考来源、可用设置、文件位置和未完成检查。",
      "rationale": "批次可追溯，成员接续工作时能判断所用依据。",
      "allowed_variation": [
        "工具不返回模型版本或seed时明确记录unknown或null，不猜测"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "technical",
      "status": "proposed"
    },
    {
      "id": "REVIEW-01",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "分别记录版本门、艺术门与工程门的检查；无证据、未查看或未测试均不能记为通过。模拟数据和draft包不得转述为总监批准或真实量产交付。",
      "rationale": "让可复查的机器检查与需要实际观察的判断保持清楚。",
      "allowed_variation": [
        "不适用项可标not_applicable并写理由；不影响其他适用项"
      ],
      "evidence": [
        "PB-ART-DIRECTION"
      ],
      "verification": "human",
      "status": "proposed"
    }
  ],

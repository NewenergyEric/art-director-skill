{
  "schema_version": "1.0",
  "project": {
    "id": "tidekeeper",
    "name": "潮灯小镇 · 四类资产交接试作",
    "domain": "game-art",
    "owner": "原创案例自测，待真实项目主美审阅"
  },
  "version": "0.2.1",
  "status": "draft",
  "scope": {
    "medium": "2D casual mobile merge-game art and editable UI study",
    "view": "角色对话立绘 / 俯视三分之四地图 / 轻俯视棋子 / 平面UI，各自有样板",
    "target_platform": "390×844 浏览器试作；真实手机与引擎待测",
    "asset_types": [
      "character",
      "environment",
      "prop",
      "ui"
    ]
  },
  "intent": {
    "summary": "一个团队/项目，一份视觉记忆。沿用首版角色、场景与灯具，新做动作、修复状态和等级；收到反馈后升版补齐游戏UI资产、状态与竖屏安全区。",
    "pillars": [
      "像休闲合成游戏，先服务格内识别与操作",
      "保留海港修复的共同形状与色彩语言",
      "身份、类别、单次变化分开，组合时检验"
    ],
    "avoid": [
      "把宣传插画当游戏画面标准",
      "让写实金属噪点淹没小格轮廓",
      "只统一配色而不统一结构、镜头和状态"
    ]
  },
  "tokens": {
    "colors": {
      "teal": "#2DAEA3",
      "gold": "#F8C353",
      "cream": "#FFF1CA",
      "coral": "#F17F63",
      "ink": "#214C50"
    },
    "fonts": {
      "ui": {
        "family": "TideSans / Noto Sans SC",
        "fallback": [
          "Microsoft YaHei",
          "sans-serif"
        ]
      }
    }
  },
  "rules": [
    {
      "id": "TK-FORM",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "饱满大体块、干净局部色、柔和宽高光与上左主光；按类别简化细节。不是每件都涂同一种颜色或材料。",
      "rationale": "让同一世界在不同资源职责下成立。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-NOTES"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-USE",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "先看实际使用：对话角色、地图、棋子、订单与按钮各有职责。宣传构图不继承为通用制作约束。",
      "rationale": "避免统一到错误类型或错误镜头。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-NOTES"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-CHAR-ID",
      "scope": [
        "character"
      ],
      "strength": "must",
      "statement": "阿澜：暖棕肤、棕色杏眼、浓眉、圆颊短鼻、深蓝不对称大块短卷发、小耳钉，成年体态约5.5头身。",
      "rationale": "同一人改变动作仍能识别。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-CHAR"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-CHAR-DRAW",
      "scope": [
        "character"
      ],
      "strength": "must",
      "statement": "用宽色面与柔和塑形；发型分成大块，省略发丝与布料织纹；保持小尺寸脸部表情可读。",
      "rationale": "区别剧情角色立绘与精细宣传插画。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-CHAR"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-SCENE-ID",
      "scope": [
        "environment"
      ],
      "strength": "must",
      "statement": "旧灯房：珊瑚色弧形坡屋顶、右侧烟囱、奶油墙、前面中央门和两窗、门上圆形灯徽，海水在左，木平台及门前缺板的位置固定。",
      "rationale": "修复前后应是同一地点。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-MAP"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-SCENE-VIEW",
      "scope": [
        "environment"
      ],
      "strength": "must",
      "statement": "俯视三分之四地图机位保持；不添加天空或电影镜头；只修改任务授权的修复部位。",
      "rationale": "修复状态可以直接对照。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-MAP"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-ITEM-SHAPE",
      "scope": [
        "prop"
      ],
      "strength": "must",
      "statement": "L1圆腹侧环矮灯，L2宽体拱柄提灯，L3大圆镜/U形支架探照灯，L4短粗锥形航标；两件同级生成下一级，生产器不参与此链。",
      "rationale": "同级易配对、相邻等级有轮廓差异。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-NOTES"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-ITEM-MATERIAL",
      "scope": [
        "prop"
      ],
      "strength": "must",
      "statement": "海绿主体、蜂蜜黄宽金属块、奶油灯面、珊瑚单钮；轻俯视三分之四；粗护栏与大开口。删除细螺钉、细杆、镜面噪点及外发光。",
      "rationale": "在小格内看见功能轮廓。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-LAMPS"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-ITEM-SCALE",
      "scope": [
        "prop"
      ],
      "strength": "must",
      "statement": "在实际约50px棋盘格及46/64/96px比较轮廓和透明边缘；512px RGBA，完整原画布等比缩放补边，目标有效占比70–90%。",
      "rationale": "不能用大图精细代替格内清楚。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-NOTES"
      ],
      "verification": "technical",
      "status": "proposed"
    },
    {
      "id": "TK-UI-STATE",
      "scope": [
        "ui"
      ],
      "strength": "must",
      "statement": "订单有缺件/可提交/已交付状态；缺件按钮不可提交，有货交付消耗实际目标物并更新反馈。选中与生产器角标各自明确。",
      "rationale": "真实信息与反馈服务合成操作。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-UI"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-UI-TEXT",
      "scope": [
        "ui"
      ],
      "strength": "must",
      "statement": "海港角色站在奶油订单台后；暖木框、海绿双色棋格、草绿凸起动作按钮。数值17px粗斜体，按钮12px粗字与短阴影，说明11px；装饰字与可编辑正文分开。",
      "rationale": "文字和图像各司其职；数值仍为试作设置。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-UI",
        "TK-FONT"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-COMPOSE",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "最终使用同版本的真实成员输出组合检查；对话立绘是UI叠层，不作为等距地图小人；棋子不可压住格子边界和角标。",
      "rationale": "分开正确也要组合正确。",
      "allowed_variation": [
        "只变化本任务声明的槽位，保留其余结构。"
      ],
      "evidence": [
        "TK-NOTES"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-UI-ART",
      "scope": [
        "ui"
      ],
      "strength": "must",
      "statement": "UI须包含本项目角色订单、贝壳金币、体力、两条合成链、生产器、锁定货箱、状态标记与物品说明。每项对应可读职责，不添加无效充值或活动按钮。",
      "rationale": "此次组合自测与用户反馈暴露的缺口。",
      "allowed_variation": [
        "任务声明的文案与状态，保留共同语言。"
      ],
      "evidence": [
        "TK-UI",
        "TK-UI-SHOT"
      ],
      "verification": "visual",
      "status": "proposed"
    },
    {
      "id": "TK-VIEWPORT",
      "scope": [
        "environment",
        "ui"
      ],
      "strength": "must",
      "statement": "使用竖版前后适配图，保留屋顶、门、两扇正窗和平台；390×844中完整显示建筑，不把横图直接cover铺满。",
      "rationale": "此次组合自测与用户反馈暴露的缺口。",
      "allowed_variation": [
        "任务声明的文案与状态，保留共同语言。"
      ],
      "evidence": [
        "TK-PORTRAIT-BEFORE",
        "TK-PORTRAIT-AFTER"
      ],
      "verification": "visual",
      "status": "proposed"
    }
  ],

  "version": "0.5.0",
  "status": "draft",
  "scope": {
    "medium": "电商横幅、宣传海报与组件的团队组合设计",
    "view": "由投放渠道画布与裁切决定",
    "target_platform": "待提供真实投放规格",
    "asset_types": [
      "product",
      "graphic",
      "typography",
      "layout",
      "ui"
    ]
  },
  "intent": {
    "summary": "示范商品、活动装饰、真实文字与组合版式由不同成员制作，却沿用同一活动规范与版本。当前仅有文本方向和任务编译，没有品牌母版或已完成海报。",
    "pillars": [
      "先认出商品，再读懂活动",
      "多个渠道保持同一活动身份",
      "装饰与版式留创意空间"
    ],
    "avoid": [
      "模型改写商品包装或品牌标识",
      "凭空补价格、折扣、日期、功能卖点",
      "单元素合格却在组合画面中遮挡主要信息"
    ]
  },
  "tokens": {
    "colors": {
      "candidate_cream": "#FFF4DB",
      "candidate_citrus": "#F5A838",
      "candidate_ink": "#24352C"
    },
    "fonts": {}
  },
  "rules": [
    {
      "id": "CAMPAIGN-STYLE",
      "scope": [
        "global"
      ],
      "strength": "must",
      "statement": "候选活动方向采用奶油底色、柑橘色点缀与深色文字，信息清楚；具体颜色和样板尚待品牌负责人确认。",
      "rationale": "给所有成员同一活动方向，但不冒充已批准品牌标准。",
      "allowed_variation": [],
      "evidence": [
        "CAMPAIGN-BRIEF"
      ],
      "verification": "human",
      "status": "proposed"
    },
    {
      "id": "PRODUCT-IDENTITY",
      "scope": [
        "product"
      ],
      "strength": "must",
      "statement": "商品瓶型、包装、标识、容量和真实标签沿用品牌母版；母版尚缺，不能凭文字合成的包装作为真实商品交付。",
      "rationale": "商品身份是底线，背景换风格不代表可以改商品。",
      "allowed_variation": [],
      "evidence": [
        "CAMPAIGN-BRIEF"
      ],
      "verification": "human",
      "status": "proposed"
    },
    {
      "id": "DECORATION-SPACE",
      "scope": [
        "graphic"
      ],
      "strength": "must",
      "statement": "装饰元素保留独立透明文件，不烘焙价格和品牌字；合成后不覆盖标签、主要文案及点击区域。",
      "rationale": "跨成员复用和组合需要独立元素及实际合成检查。",
      "allowed_variation": [],
      "evidence": [
        "CAMPAIGN-BRIEF"
      ],
      "verification": "human",
      "status": "proposed"
    },
    {
      "id": "COPY-TRUTH",
      "scope": [
        "typography",
        "layout"
      ],
      "strength": "must",
      "statement": "本案例只提供占位活动标题‘周末轻饮’，不是投放文案。价格、优惠、时间和细则未给出时保持待补，不自行填写。真实文案用可编辑文字层排版逐字核对。",
      "rationale": "实际文字与事实必须来自活动负责人，生图里的近似字形不能作为排版。",
      "allowed_variation": [],
      "evidence": [
        "CAMPAIGN-BRIEF"
      ],
      "verification": "human",
      "status": "proposed"
    },
    {
      "id": "TYPE-HIERARCHY",
      "scope": [
        "typography"
      ],
      "strength": "must",
      "statement": "按活动标题、核心利益、行动信息和细则定义层级；字体文件、字重与最小显示字号都待实际选定和检验。",
      "rationale": "不同成员制作的字块在最终画面中仍需连续清楚。",
      "allowed_variation": [],
      "evidence": [
        "CAMPAIGN-BRIEF"
      ],
      "verification": "human",
      "status": "proposed"
    },
    {
      "id": "COMPOSITION-CONTEXT",
      "scope": [
        "layout"
      ],
      "strength": "must",
      "statement": "组合任务同时读取商品、装饰、字体规则；在目标画布检查商品占比、信息顺序、遮挡、安全区及渠道裁切，并与系列其他尺寸并排比较。",
      "rationale": "单个元素正确不能证明最终海报或促销页面一致。",
      "allowed_variation": [],
      "evidence": [
        "CAMPAIGN-BRIEF"
      ],
      "verification": "human",
      "status": "proposed"
    }
  ],

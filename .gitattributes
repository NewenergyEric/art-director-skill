* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.zip binary
*.gif binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp4 binary
*.woff2 binary
# Captions are published as byte-verified media; keep the same bytes on every OS.
*.vtt text eol=lf
# Frozen playable imports are verified against their original ZIP bytes.
docs/assets/tidekeeper-playable/** -text whitespace=cr-at-eol
docs/assets/duskwood-watch/** -text whitespace=cr-at-eol
# Preserve upstream license text and frozen generation-record whitespace.
docs/assets/fonts/*-OFL.txt -whitespace
motion/public/fonts/*-OFL.txt -whitespace
docs/assets/duskwood-watch/assets/notosanssc-OFL.txt -whitespace
docs/assets/tidekeeper-playable/art/expansion/generation-scenes.md whitespace=cr-at-eol,-blank-at-eof
